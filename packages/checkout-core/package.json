{
  "name": "@edgeos/checkout-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-agnostic headless checkout engine for EdgeOS — store, typed API client, server-authoritative pricing, cart, form validation and analytics. Zero UI, zero framework.",
  "keywords": [
    "edgeos",
    "checkout",
    "headless",
    "commerce",
    "ecommerce",
    "tickets",
    "payments",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2p-lanes/edgeos-monorepo.git",
    "directory": "packages/checkout-core"
  },
  "homepage": "https://github.com/p2p-lanes/edgeos-monorepo/tree/main/packages/checkout-core#readme",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "echo 'No lint script'",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "tsup"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
