# Source this file with `set -a; source ...; set +a` before running the backend.
# Development-only credentials, isolated PostgreSQL database from compose.yaml.
ENVIRONMENT=dev
PROJECT_NAME=EdgeOS
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-sso-only
POSTGRES_DB=edgeos_sso
POSTGRES_SSL_MODE=disable
SECRET_KEY=local-sso-example-not-for-production-0123456789
SUPERADMIN=admin@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=false
SMTP_SSL=false
SMTP_USER=local
SMTP_PASSWORD=local
SENDER_EMAIL=noreply@example.com
SENTRY_DSN=http://local@localhost:9999/1
REDIS_URL=redis://localhost:6379
BACKEND_URL=http://localhost:8000
BACKOFFICE_URL=http://localhost:5173
PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_PORTAL_DOMAIN=localhost:3000
